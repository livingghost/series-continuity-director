    "cues": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "start": {"type": "number"}, "end": {"type": "number"}, "speaker": {"type": ["string", "null"]}, "text": {"type": "string", "minLength": 1}, "source_line": {"type": "object", "properties": {"document": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}}, "required": ["document", "id"], "additionalProperties": false}, "word_timing": {"type": ["array", "null"], "items": {"type": "object", "properties": {"text": {"type": "string", "minLength": 1}, "start": {"type": "number"}, "end": {"type": "number"}}, "required": ["text", "start", "end"], "additionalProperties": false}}}, "required": ["id", "start", "end", "speaker", "text", "source_line", "word_timing"], "additionalProperties": false}},
