{
  "type": "object",
  "properties": {
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "enum": [
        "portable-text",
        "target-adapted",
        "lane-comparison",
        "end-to-end"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "observed-use",
              "constructed-case"
            ]
          },
          "origin_note": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "dimension": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "technical",
                    "behavioral",
                    "expressive"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "dimension",
                "kind",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "origin",
          "origin_note",
          "inputs",
          "criteria"
        ],
        "additionalProperties": false
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "case": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "run": {
            "type": [
              "string",
              "null"
            ]
          },
          "candidate": {
            "type": [
              "string",
              "null"
            ]
          },
          "measurements": {
            "type": [
              "string",
              "null"
            ]
          },
          "temporal_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "audio_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "delivery_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "cost": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "exact",
                  "bounded",
                  "unknown",
                  "not-applicable"
                ]
              },
              "amount": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "currency": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "status",
              "amount",
              "currency"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "case",
          "condition",
          "run",
          "candidate",
          "measurements",
          "temporal_evidence",
          "audio_evidence",
          "delivery_evidence",
          "cost"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "purpose",
    "strategy",
    "cases",
    "conditions",
    "trials"
  ],
  "additionalProperties": false
}
