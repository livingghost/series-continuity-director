{
  "type": "object",
  "properties": {
    "purpose": {"type": "string", "minLength": 1},
    "lane": {"enum": ["single-generated-sequence", "independent-shots", "endpoint-conditioned-chain", "edit-existing-media"]},
    "edit_clock": {
      "type": "object",
      "properties": {
        "unit": {"enum": ["seconds", "frames"]},
        "rate": {
          "anyOf": [
            {"type": "null"},
            {"type": "object", "properties": {"numerator": {"type": "integer", "minimum": 1}, "denominator": {"type": "integer", "minimum": 1}}, "required": ["numerator", "denominator"], "additionalProperties": false}
          ]
        }
      },
      "required": ["unit", "rate"],
      "additionalProperties": false
    },
    "target_edit_span": {"type": "object", "properties": {"start": {"type": "number"}, "end": {"type": "number"}}, "required": ["start", "end"], "additionalProperties": false},
    "surface": {
      "type": "object",
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "service": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "input_mode": {"type": "string", "minLength": 1}
      },
      "required": ["model", "service", "operation", "input_mode"],
      "additionalProperties": false
    },
    "generation_duration": {
      "type": "object",
      "properties": {
        "kind": {"enum": ["discrete", "range", "not-applicable"]},
        "values": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}},
        "minimum": {"type": ["number", "null"]},
        "maximum": {"type": ["number", "null"]},
        "step": {"type": ["number", "null"]}
      },
      "required": ["kind", "values", "minimum", "maximum", "step"],
      "additionalProperties": false
    },
    "reference_contract": {
      "type": "object",
      "properties": {
        "maximum": {"type": "integer", "minimum": 0},
        "roles": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "exclusive_role_sets": {"type": "array", "items": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 2}}
      },
      "required": ["maximum", "roles", "exclusive_role_sets"],
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "edit": {"type": "object", "properties": {"start": {"type": "number"}, "end": {"type": "number"}}, "required": ["start", "end"], "additionalProperties": false},
          "generation_seconds": {"type": ["number", "null"]},
          "source_use": {"type": ["object", "null"], "properties": {"start": {"type": "number"}, "end": {"type": "number"}}, "required": ["start", "end"], "additionalProperties": false},
          "playback_rate": {"type": "number", "exclusiveMinimum": 0},
          "pre_handle": {"type": "number", "minimum": 0},
          "post_handle": {"type": "number", "minimum": 0},
          "reference_roles": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "cues": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "required": ["id", "edit", "generation_seconds", "source_use", "playback_rate", "pre_handle", "post_handle", "reference_roles", "cues", "limitations"],
        "additionalProperties": false
      }
    },
    "cost_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "required": ["purpose", "lane", "edit_clock", "target_edit_span", "surface", "generation_duration", "reference_contract", "units", "cost_conditions", "assumptions", "unresolved"],
  "additionalProperties": false
}
