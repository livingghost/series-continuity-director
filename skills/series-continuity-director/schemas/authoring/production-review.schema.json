{
  "type": "object",
  "properties": {
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "locator": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "whole"
                    ]
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "description"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "lines",
                      "bytes"
                    ]
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "region"
                    ]
                  },
                  "unit": {
                    "enum": [
                      "normalized"
                    ]
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  }
                },
                "required": [
                  "kind",
                  "unit",
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "time"
                    ]
                  },
                  "unit": {
                    "enum": [
                      "seconds"
                    ]
                  },
                  "start": {
                    "type": "number"
                  },
                  "end": {
                    "type": "number"
                  },
                  "stream": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "unit",
                  "start",
                  "end",
                  "stream"
                ],
                "additionalProperties": false
              }
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "visual-inspection",
              "audio-inspection",
              "text-inspection",
              "measurement",
              "operator-report"
            ]
          }
        },
        "required": [
          "locator",
          "observation",
          "method"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "not-assessed",
              "not-applicable"
            ]
          },
          "observation_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1
          },
          "evidence_basis": {
            "enum": [
              "reviewer-interpretation",
              "audience-report",
              "technical-measurement",
              "not-assessed"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "criterion",
          "verdict",
          "observation_indices",
          "evidence_basis",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decisions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "observation_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expected_evidence": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "decisions",
          "observation_indices",
          "operation",
          "scope",
          "reason",
          "expected_evidence",
          "targets"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "visual_assessment": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "subjects": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "character_id": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ]
                  },
                  "continuity": {
                    "enum": [
                      "recurring",
                      "one-off",
                      "undecided"
                    ]
                  }
                },
                "required": [
                  "character_id",
                  "continuity"
                ],
                "additionalProperties": false
              }
            },
            "observation_indices": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "subjects",
            "observation_indices"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "input_sha256",
    "candidate",
    "reviewer",
    "observations",
    "checks",
    "repairs",
    "unresolved",
    "conclusion"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "checks": {
            "contains": {
              "type": "object",
              "properties": {
                "verdict": {
                  "const": "fail"
                }
              },
              "required": [
                "verdict"
              ]
            }
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "repairs": {
                "minItems": 1
              }
            },
            "required": [
              "repairs"
            ]
          },
          {
            "properties": {
              "unresolved": {
                "minItems": 1
              }
            },
            "required": [
              "unresolved"
            ]
          }
        ]
      }
    }
  ]
}
