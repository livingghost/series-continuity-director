    "reference_activation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "purpose",
    "basis",
    "subjects",
    "shot_camera",
    "shot_request",
    "reference_activation"
