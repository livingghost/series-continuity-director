{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "target-profile.schema.json",
  "title": "Target Profile",
  "description": "Durable, per-model facts about a generation or editing surface: what it accepts and how it wants to be addressed. Separate from any project's decisions about what to send it.",
  "type": "object",
  "required": [
    "artifact_type",
    "target_id",
    "label",
    "model_identifier",
    "media_kind",
    "evidence",
    "prompt_contract",
    "offerings",
    "profile_sha256"
  ],
  "properties": {
    "artifact_type": {
      "const": "target-profile"
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "model_identifier": {
      "type": "string",
      "minLength": 1,
      "description": "The exact identifier the surface accepts, not a product family name."
    },
    "media_kind": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "image",
          "video",
          "audio",
          "video-with-audio",
          "3d",
          "text"
        ]
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "checked_on",
        "sources"
      ],
      "properties": {
        "checked_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "reference"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "surface-control",
                  "vendor-documentation",
                  "user-supplied",
                  "preserved-run"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "prompt_contract": {
      "type": "object",
      "description": "What the surface expects the text to carry. A named layer that goes unstated is filled by a surface default, not left neutral.",
      "required": [
        "layers"
      ],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_layers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "style": {
          "type": "string",
          "description": "Prose, tag list, structured sections, or another documented form."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "camera_control": {
      "type": "object",
      "description": "How camera movement is addressed. A named vocabulary is a constraint on shot planning, not only on wording.",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "named-commands",
            "free-description",
            "named-commands-preferred",
            "none"
          ]
        },
        "command_syntax": {
          "type": "string",
          "description": "Exact syntax form, when the surface documents one."
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "framing_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "moves_per_shot": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "multi_shot_control": {
      "type": "object",
      "description": "Whether several shots can live inside one generated clip.",
      "required": [
        "supported"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "syntax": {
          "type": "string"
        },
        "min_shot_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_shot_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shot_budget": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "duration_seconds",
              "shots"
            ],
            "properties": {
              "duration_seconds": {
                "type": "string",
                "minLength": 1
              },
              "shots": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "duration_control": {
      "type": "object",
      "properties": {
        "min_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "granularity": {
          "type": "string"
        },
        "sweet_spots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "audio_control": {
      "type": "object",
      "properties": {
        "generates_audio": {
          "type": "boolean"
        },
        "sound_syntax": {
          "type": "string"
        },
        "dialogue_syntax": {
          "type": "string"
        },
        "unspecified_behaviour": {
          "type": "string",
          "description": "What the surface does when audio is not addressed."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "frame_control": {
      "type": "object",
      "description": "Which parameter actually decides output geometry, which is not always the one that looks like it should.",
      "properties": {
        "aspect_parameter": {
          "type": "string"
        },
        "resolution_parameter": {
          "type": "string"
        },
        "supported_geometries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "input_modes": {
      "type": "array",
      "description": "Each mode changes what the media supplies and therefore what the text must still establish.",
      "items": {
        "type": "object",
        "required": [
          "mode",
          "media_supplies",
          "text_must_establish"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "request_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limits": {
            "type": "string"
          },
          "media_supplies": {
            "type": "string",
            "minLength": 1
          },
          "text_must_establish": {
            "type": "string",
            "minLength": 1
          },
          "excludes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "anti_patterns": {
      "type": "array",
      "description": "Documented or observed wording and requests that degrade this surface.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "identity_reference": {
      "type": "object",
      "description": "What this surface needs from an image submitted as an identity reference. Present only where the surface documents it or a preserved run established it; absent means the surface has said nothing, not that anything goes.",
      "required": [
        "minimum_shorter_side"
      ],
      "properties": {
        "minimum_shorter_side": {
          "type": "integer",
          "minimum": 1,
          "description": "Pixels on the shorter side, below which this surface does not carry a likeness. The submission may raise it for one run. It is not lowered."
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "offerings": {
      "type": "array",
      "description": "How this model is exposed on each service: identifier there, the request key each input mode occupies, and the limits that service enforces for it. One entry per service; a submission names the service when there is more than one.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "model_identifier",
          "request_keys",
          "constraints",
          "observed_at"
        ],
        "properties": {
          "service": {
            "type": "string",
            "minLength": 1
          },
          "model_identifier": {
            "type": "string",
            "minLength": 1
          },
          "request_keys": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "constraints": {
            "type": "object"
          },
          "observed_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "schema_snapshot": {
            "type": "string",
            "description": "Path, relative to the suite root, of the observed parameter schema for this offering (an observed-parameter-schema artifact)."
          }
        }
      }
    }
  },
  "additionalProperties": false
}
